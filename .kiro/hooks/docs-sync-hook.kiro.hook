{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Listens to TypeScript source files and configuration changes to automatically update project documentation",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx",
      "*.js",
      "*.jsx",
      "src/**/*.ts",
      "src/**/*.tsx",
      "pages/**/*.tsx",
      "package.json",
      "tsconfig.json",
      "README.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code or configuration files have been modified. Please review the changes and update the README.md file to reflect any new features, API changes, or structural modifications. Ensure the documentation accurately represents the current state of the codebase, including any new components, pages, or functionality."
  }
}